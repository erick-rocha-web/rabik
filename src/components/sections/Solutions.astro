---
import WhatsAppCta from '../ui/WhatsAppCta.astro';
import { solutions } from '../../data/solutions';
---
<section id="solucoes" class="section" aria-labelledby="solucoes-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Soluções sem complicar</p>
      <h2 id="solucoes-title" class="section-title">Você escolhe o ponto de partida.</h2>
    </div>

    <div class="selector" data-reveal data-solutions>
      <fieldset class="options">
        <legend class="visually-hidden">Escolha o ponto de partida</legend>
        {solutions.map((s, i) => (
          <label class="option">
            <input type="radio" name="solucao" value={s.id} checked={i === 0} data-index={i} />
            <span class="option-body">
              <span class="option-title">{s.title}</span>
              <span class="option-text">{s.text}</span>
            </span>
          </label>
        ))}
      </fieldset>

      <div class="answer">
        {solutions.map((s, i) => (
          <p class="guidance" data-panel={i}><strong>{s.title}:</strong> {s.guidance}</p>
        ))}

        <div class="editor" data-editor hidden>
          <label for="solucao-mensagem">Mensagem que vai para o WhatsApp <span class="muted">(pode editar)</span></label>
          <textarea id="solucao-mensagem" rows="5" maxlength="1000" data-message>{solutions[0].message}</textarea>
        </div>

        {solutions.map((s, i) => (
          <div class="cta" data-panel={i}>
            <WhatsAppCta label={s.cta} message={s.message} />
          </div>
        ))}
        <p class="small muted">Nada é enviado automaticamente: você revisa a mensagem no WhatsApp antes de enviar.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .selector { display: grid; gap: 20px; }
  @media (min-width: 900px) {
    .selector { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  }
  .options { display: grid; gap: 12px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .option { position: relative; display: block; cursor: pointer; }
  .option input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .option-body {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 18px 20px 18px 56px;
    border: 2px solid var(--control-border);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  /* Marcador de rádio visível: o estado não depende só da cor. */
  .option-body::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 21px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--white);
  }
  .option:hover .option-body { border-color: var(--ink); }
  .option input:checked + .option-body { border-color: var(--ink); background: var(--blue-soft); box-shadow: var(--shadow-sticker); }
  .option input:checked + .option-body::before { background: var(--action); box-shadow: inset 0 0 0 3px var(--white); }
  .option input:focus-visible + .option-body { outline: 3px solid var(--focus); outline-offset: 3px; }
  .option-title { font-family: var(--font-display); font-weight: 800; font-size: 1.125rem; }
  .option-text { color: var(--muted); font-size: 0.9375rem; line-height: 1.5; }

  .answer {
    display: grid;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--yellow-soft);
    border: 2px solid var(--ink);
  }
  .guidance { font-size: 1.0625rem; }
  .guidance, .cta { display: none; }
  .guidance[data-panel='0'], .cta[data-panel='0'] { display: block; }
  .selector:has(input[data-index='1']:checked) :is(.guidance, .cta)[data-panel='0'],
  .selector:has(input[data-index='2']:checked) :is(.guidance, .cta)[data-panel='0'] { display: none; }
  .selector:has(input[data-index='1']:checked) :is(.guidance, .cta)[data-panel='1'],
  .selector:has(input[data-index='2']:checked) :is(.guidance, .cta)[data-panel='2'] { display: block; }

  .editor { display: grid; gap: 8px; }
  .editor[hidden] { display: none; }
  .editor label { font-weight: 700; font-size: 0.9375rem; }
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--control-border);
    border-radius: var(--radius-sm);
    background: var(--white);
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
  }
  textarea:hover { border-color: var(--ink); }
  textarea:focus-visible { border-color: var(--ink); outline-offset: 1px; }
</style>

<script>
  import { buildWhatsAppUrl } from '../../lib/whatsapp';

  // Aprimoramento: mensagem editável única. Sem JS, cada opção já tem seu CTA com a mensagem padrão.
  const root = document.querySelector<HTMLElement>('[data-solutions]');
  const editor = root?.querySelector<HTMLElement>('[data-editor]');
  const textarea = root?.querySelector<HTMLTextAreaElement>('[data-message]');
  if (root && editor && textarea) {
    editor.hidden = false;
    const defaults = new Map<string, string>();
    root.querySelectorAll<HTMLElement>('.cta').forEach((cta) => {
      const el = cta.querySelector<HTMLElement>('[data-wa-message]');
      if (el) defaults.set(cta.dataset.panel ?? '', el.dataset.waMessage ?? '');
    });

    const applyMessage = (message: string) => {
      root.querySelectorAll<HTMLElement>('.cta [data-wa-message]').forEach((el) => {
        el.dataset.waMessage = message; // sempre texto; nunca innerHTML
        if (el instanceof HTMLAnchorElement) {
          const url = buildWhatsAppUrl(el.dataset.waDigits, message);
          if (url) el.href = url;
        }
      });
    };

    root.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'solucao') return;
      textarea.value = defaults.get(input.dataset.index ?? '') ?? textarea.value;
      applyMessage(textarea.value);
    });
    textarea.addEventListener('input', () => applyMessage(textarea.value));
  }
</script>
