---
import Icon from '../ui/Icon.astro';
import WhatsAppCta from '../ui/WhatsAppCta.astro';
import { offerText, customOffer } from '../../config/offers';
import { messages } from '../../config/messages';
---
<section id="investimento" class="section" aria-labelledby="investimento-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Investimento</p>
      <h2 id="investimento-title" class="section-title">{offerText.title}</h2>
    </div>

    <div class="plans" data-reveal>
      <article class="plan main" aria-labelledby="plano-basico">
        <div class="top">
          <div class="price-block">
            <h3 id="plano-basico" class="plan-name">{offerText.name}</h3>
            <p class="price">{offerText.price}</p>
            <p class="desc">{offerText.description}</p>
          </div>
          <dl class="terms">
            <div class="term pay">
              <dt>Pagamento</dt>
              <dd>{offerText.payment}</dd>
            </div>
            <div class="term renew">
              <dt>Renovação anual</dt>
              <dd>{offerText.renewal}</dd>
            </div>
          </dl>
        </div>

        <ul class="highlights" role="list">
          {offerText.highlights.map((h) => <li><Icon name="check" /> <span>{h}</span></li>)}
        </ul>

        <p class="deadline small">{offerText.deadline}</p>

        <details class="included">
          <summary>
            <span>Ver o que está incluído em detalhe</span>
            <Icon name="plus" class="chev" />
          </summary>
          <ul role="list">{offerText.details.map((d) => <li>{d}</li>)}</ul>
        </details>

        <WhatsAppCta label={offerText.cta} message={messages.basicOffer} class="plan-cta" />
      </article>

      <article class="plan custom" aria-labelledby="plano-sob-medida">
        <h3 id="plano-sob-medida" class="plan-name">{customOffer.title}</h3>
        <p>{customOffer.text}</p>
        <p class="price price-text">{customOffer.price}</p>
        <WhatsAppCta label={customOffer.cta} message={messages.custom} variant="secondary" />
      </article>
    </div>
  </div>
</section>

<style>
  .plans { display: grid; gap: 20px; align-items: start; }
  @media (min-width: 980px) { .plans { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 28px; } }
  .plan { display: grid; gap: 20px; padding: 24px; border: 2px solid var(--ink); border-radius: var(--radius-lg); }
  @media (min-width: 640px) { .plan { padding: 30px; } }
  .main { background: var(--white); box-shadow: 8px 8px 0 var(--yellow); }
  .custom { background: var(--mint-soft); gap: 14px; }
  .top { display: grid; gap: 20px; }
  @media (min-width: 720px) { .top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; } }
  .price-block { display: grid; gap: 6px; }
  .plan-name { font-size: 1.1875rem; }
  .price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 2rem + 1.6vw, 3.25rem); letter-spacing: -0.03em; line-height: 1.05; }
  .price-text { font-size: 1.75rem; }
  .desc { color: var(--muted); }
  .terms { display: grid; gap: 10px; margin: 0; }
  .term { padding: 12px 14px; border-radius: var(--radius-sm); border: 1.5px solid var(--ink); }
  .pay { background: var(--yellow-soft); }
  .renew { background: var(--blue-soft); }
  .term dt { font-family: var(--font-display); font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .term dd { margin: 4px 0 0; font-size: 0.9375rem; line-height: 1.5; }
  .highlights { display: grid; gap: 10px; margin: 0; }
  @media (min-width: 720px) { .highlights { grid-template-columns: 1fr 1fr; column-gap: 28px; } }
  .highlights li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: 0.9375rem; }
  .highlights :global(.icon) { width: 22px; height: 22px; color: var(--blue-dark); stroke-width: 2.5; margin-top: 1px; }
  .deadline { color: var(--muted); }
  .included { border-top: 1.5px solid var(--line); border-bottom: 1.5px solid var(--line); }
  .included summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 52px; font-weight: 700; cursor: pointer; list-style: none;
  }
  .included summary::-webkit-details-marker { display: none; }
  .included summary:hover { color: var(--blue-dark); }
  .included :global(.chev) { width: 20px; height: 20px; flex: none; transition: transform var(--dur-fast) ease; }
  .included[open] :global(.chev) { transform: rotate(45deg); }
  .included ul { display: grid; gap: 8px; margin: 0; padding: 0 0 18px; }
  .included li { position: relative; padding-left: 18px; font-size: 0.9375rem; color: var(--muted); }
  .included li::before { content: ''; position: absolute; left: 2px; top: 0.65em; width: 7px; height: 7px; border-radius: 50%; background: var(--coral); }
  .plan :global(.plan-cta) { justify-self: start; }
</style>
