---
/**
 * Destaque animado para trechos de título.
 * - marker: marca-texto amarelo passa por trás do texto e as letras dão um pulinho em onda.
 * - label: etiqueta escura entra da esquerda e as letras "aparecem" uma a uma.
 * O texto real fica num span invisível para leitores de tela; as letras separadas são só visuais.
 * Sem animação (prefers-reduced-motion), o destaque aparece pronto.
 */
interface Props {
  text: string;
  tone: 'marker' | 'label';
  /** Atraso do início da animação, em ms. */
  delay?: number;
}
const { text, tone, delay = 0 } = Astro.props;
let n = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---
<span class:list={['hl', tone]} style={`--delay:${delay}ms`}><span class="visually-hidden">{text}</span><span aria-hidden="true">{words.map((word, w) => <Fragment>{w > 0 && ' '}<span class="word">{word.map(({ ch, i }) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span></Fragment>)}</span></span>

<style>
  @property --sweep {
    syntax: '<number>';
    inherits: false;
    initial-value: 1;
  }

  .hl {
    --sweep: 1;
    position: relative;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background-repeat: no-repeat;
  }
  .word { display: inline-block; white-space: nowrap; }
  .ch { display: inline-block; }

  /* Marca-texto: faixa mais baixa que a linha, para não invadir a linha de cima. */
  .marker {
    padding: 0 0.1em;
    margin: 0 -0.06em;
    background-image: linear-gradient(100deg, var(--yellow) 0%, #ffc93f 100%);
    background-size: calc(var(--sweep) * 100%) 0.62em;
    background-position: 0 88%;
  }

  /* Etiqueta: fundo tinta, letras papel e sombra coral no estilo dos stickers.
     A linha da etiqueta fica mais alta para o fundo não cobrir as descendentes da linha de cima. */
  .label {
    line-height: 1.42;
    padding: 0 0.2em;
    margin-left: 0.04em;
    border-radius: 0.2em;
    color: var(--paper-strong);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: calc(var(--sweep) * 100%) 100%;
    background-position: 0 0;
    box-shadow: 0.09em 0.09em 0 var(--coral);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hl { animation: sweep 560ms var(--ease-out) both var(--delay); }

    .marker .ch {
      animation: hop 420ms var(--ease-out) both;
      animation-delay: calc(var(--delay) + 160ms + var(--i) * 38ms);
    }

    .label { animation: sweep 560ms var(--ease-out) both var(--delay), stamp 260ms var(--ease-out) both; animation-delay: var(--delay), calc(var(--delay) + 480ms); }
    .label .ch {
      animation: letter-in 460ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
      animation-delay: calc(var(--delay) + 260ms + var(--i) * 34ms);
    }

    @keyframes sweep { from { --sweep: 0; } to { --sweep: 1; } }
    @keyframes hop {
      0%, 100% { transform: translateY(0); }
      45% { transform: translateY(-0.14em) rotate(-3deg); }
    }
    @keyframes letter-in {
      from { opacity: 0; transform: translateY(0.45em) rotate(8deg) scale(0.6); }
      to { opacity: 1; transform: none; }
    }
    @keyframes stamp {
      from { box-shadow: 0 0 0 transparent; }
      to { box-shadow: 0.09em 0.09em 0 var(--coral); }
    }
  }
</style>
